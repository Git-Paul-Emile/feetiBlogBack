generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["feeti_blog"]
}

model BlogCategory {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String        @unique
  articles  BlogArticle[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("categories")
  @@schema("feeti_blog")
}

model BlogArticle {
  id            String               @id @default(cuid())
  slug          String               @unique
  position      Int                  @unique
  categorySlug  String
  category      BlogCategory         @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  readTime      String
  title         String
  excerpt       String
  lead          String
  imageUrl      String               @default("")
  imagePublicId String               @default("")
  sections      BlogArticleSection[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([categorySlug, position])
  @@map("articles")
  @@schema("feeti_blog")
}

model BlogAdmin {
  id                String                       @id @default(cuid())
  email             String                       @unique
  name              String
  passwordHash      String
  emailVerifiedAt   DateTime?
  sessions          BlogAdminSession[]
  verificationTokens BlogEmailVerificationToken[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@map("admin_users")
  @@schema("feeti_blog")
}

model BlogAdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  admin     BlogAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([adminId, expiresAt])
  @@map("admin_sessions")
  @@schema("feeti_blog")
}

model BlogEmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  admin     BlogAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([adminId, expiresAt])
  @@map("admin_email_verification_tokens")
  @@schema("feeti_blog")
}

model BlogArticleSection {
  id         String      @id @default(cuid())
  articleId  String
  position   Int
  title      String
  paragraphs String[]
  article    BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@map("article_sections")
  @@schema("feeti_blog")
}

model BlogTutorial {
  id            String   @id @default(cuid())
  slug          String   @unique
  position      Int      @unique
  duration      String
  level         String
  title         String
  description   String
  imageUrl      String
  imagePublicId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([level, position])
  @@map("tutorials")
  @@schema("feeti_blog")
}

model BlogInfoPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  eyebrow   String
  title     String
  intro     String
  sections  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("info_pages")
  @@schema("feeti_blog")
}

model BlogProduct {
  id               String               @id @default(cuid())
  slug             String               @unique
  position         Int                  @unique
  indexLabel       String               @map("index")
  name             String
  eyebrow          String
  title            String
  description      String
  accent           String
  soft             String
  imageUrl         String
  imageAlt         String
  imagePublicId    String
  stat             String
  outcome          String
  quote            String
  quoteAttribution String
  cta              String
  contact          String
  features         BlogProductFeature[]
  steps            BlogProductStep[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("products")
  @@schema("feeti_blog")
}

model BlogProductFeature {
  id          String      @id @default(cuid())
  productId   String
  position    Int
  title       String
  description String
  product     BlogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_features")
  @@schema("feeti_blog")
}

model BlogProductStep {
  id          String      @id @default(cuid())
  productId   String
  position    Int
  title       String
  description String
  product     BlogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_steps")
  @@schema("feeti_blog")
}
